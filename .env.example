# .env.example — set these as Vercel project environment variables.
# Everything lives in one Supabase project now — no second account, no card.

# Supabase — server-side (Settings -> API Keys)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # secret — server-side only, never NEXT_PUBLIC_

# Supabase — public, safe to expose in the browser bundle (same page, different keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=    # the anon / publishable key — designed to be public

# Session signing
SESSION_JWT_SECRET=               # any random 64-character hex string

# VirusTotal free public API key
VIRUSTOTAL_API_KEY=
